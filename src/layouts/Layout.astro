---
import Head from '@/components/Head/Head.astro';
import Header from '@/components/Header/Header.astro';
import Footer from '@components/Footer/Footer.astro';
import '../styles/global.css';
import { getTranslations, PL_LOCALE, type Locale } from '@/i18n/locales/utils';

interface Props {
  image?: string;
}

const { image } = Astro.props;

const locale = (Astro.currentLocale ?? PL_LOCALE) as Locale;

const t = getTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <Head
    title={t.title}
    description={t.description}
    locale={locale}
    image={image}
  />
  <body>
    <Header locale={locale} />
    <main class="h-full min-h-screen w-full py-12">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
