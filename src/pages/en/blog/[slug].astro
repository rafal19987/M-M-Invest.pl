---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import { EN_LOCALE, getTranslations, PL_LOCALE } from '@/i18n/locales/utils';
import { getReadingTime } from '@/i18n/reading-time';
import Container from '@components/Container.astro';

const locale = 'en' as const;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.locale === 'en');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = getTranslations(locale);
const readingTime = getReadingTime(post.body ?? '');

const allPosts = await getCollection('blog');
const alternatePost = allPosts.find(
  (p) =>
    p.data.translationId === post.data.translationId &&
    p.data.locale !== locale,
);

const alternateUrls = alternatePost
  ? {
      [EN_LOCALE]: `/en/blog/${post.data.slug}/`,
      [PL_LOCALE]: `/blog/${alternatePost.data.slug}/`,
    }
  : undefined;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout breadcrumbLabel={post.data.title} alternateUrls={alternateUrls}>
  <Container>
    <article>
      <h1
        class="mt-6 font-serif text-4xl leading-tight font-medium text-[#1A1D24] md:text-5xl"
      >
        {post.data.title}
      </h1>

      <div
        class="mt-6 flex flex-wrap items-center gap-3 border-y border-[#E4E1D9] py-3 font-mono text-xs text-[#6B7280]"
      >
        <span>{post.data.author}</span>
        <span class="text-[#E4E1D9]">|</span>
        <span>{dateFormatter.format(post.data.publishedDate)}</span>
        <span class="text-[#E4E1D9]">|</span>
        <span>{post.data.category}</span>
        <span class="text-[#E4E1D9]">|</span>
        <span>{readingTime} {t.blog.readingTime}</span>
      </div>

      {
        post.data.coverImage && (
          <Image
            src={post.data.coverImage}
            alt={post.data.coverImageAlt ?? ''}
            class="mt-10 aspect-video w-full object-cover"
            widths={[600, 1000, 1600]}
            sizes="(max-width: 768px) 100vw, 768px"
          />
        )
      }

      <div
        class="prose prose-neutral prose-headings:font-serif prose-headings:font-medium prose-a:text-[#26519e] prose-a:no-underline hover:prose-a:underline mt-10 max-w-none"
      >
        <Content />
      </div>
    </article>
  </Container>
</Layout>
