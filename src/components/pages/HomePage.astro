---
import { getCollection } from 'astro:content';
import { getTranslations, EN_LOCALE, type Locale } from '@/i18n/locales/utils';
import { getReadingTime } from '@/i18n/reading-time';
import Container from '@/components/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const stats = [
  { value: '12+', label: t.home.stats.years },
  { value: '48', label: t.home.stats.projects },
  { value: '120 000', label: t.home.stats.sqm },
  { value: '500+', label: t.home.stats.clients },
];

const allPosts = await getCollection(
  'blog',
  ({ data }) => data.locale === locale,
);
const latestPosts = allPosts
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  )
  .slice(0, 3)
  .map((post) => ({ ...post, readingTime: getReadingTime(post.body ?? '') }));

const blogPrefix = locale === EN_LOCALE ? '/en/blog' : '/blog';
const offerHref = locale === EN_LOCALE ? '/en/offer/' : '/oferta/';
const contactHref = locale === EN_LOCALE ? '/en/contact/' : '/kontakt/';
const aboutHref = locale === EN_LOCALE ? '/en/about-us/' : '/o-nas/';

const dateFormatter = new Intl.DateTimeFormat(
  locale === EN_LOCALE ? 'en-GB' : 'pl-PL',
  {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  },
);
---

<!-- HERO -->
<section
  class="relative overflow-hidden bg-[var(--color-brand-surface)] text-white"
>
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07]"
    aria-hidden="true"
  >
    <defs>
      <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M 48 0 L 0 0 0 48" fill="none" stroke="white" stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)"></rect>
  </svg>

  <Container>
    <div class="relative py-24 sm:py-32 lg:py-40">
      <p class="font-mono text-xs tracking-[0.2em] text-white/70 uppercase">
        {t.home.hero.eyebrow}
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl leading-tight font-[var(--font-serif)] font-medium sm:text-5xl lg:text-6xl"
      >
        {t.home.hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-white/80">{t.home.hero.subtitle}</p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={offerHref}
          class="rounded-full bg-white px-6 py-3 text-sm font-medium text-[var(--color-brand-surface)] transition-transform hover:scale-105"
        >
          {t.home.hero.ctaPrimary}
        </a>

        <a
          href={contactHref}
          class="rounded-full border border-white/30 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10"
        >
          {t.home.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </Container>
</section>

<!-- STATS -->
<section
  class="border-b border-[var(--color-border)] bg-[var(--color-surface)]"
>
  <Container>
    <div class="grid grid-cols-2 gap-8 py-12 lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div>
            <p class="text-3xl font-[var(--font-mono)] font-medium text-[var(--color-brand)] sm:text-4xl">
              {stat.value}
            </p>
            <p class="mt-1 text-sm text-[var(--color-muted)]">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<!-- ABOUT TEASER -->
<section class="py-20 sm:py-28">
  <Container>
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p
          class="text-xs font-[var(--font-mono)] tracking-[0.2em] text-[var(--color-accent)] uppercase"
        >
          {t.home.about.eyebrow}
        </p>
        <h2
          class="mt-3 text-3xl font-[var(--font-serif)] font-medium text-[var(--color-ink)] sm:text-4xl"
        >
          {t.home.about.title}
        </h2>
        <p class="mt-5 text-[var(--color-muted)]">{t.home.about.text}</p>

        <a
          href={aboutHref}
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-brand)]"
        >
          {t.home.about.cta}
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 01.75-.75h10.638L11.29 6.15a.75.75 0 111.08-1.04l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 11-1.08-1.04l3.098-3.1H3.75A.75.75 0 013 10z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>

      <div
        class="aspect-[4/3] rounded-2xl bg-[var(--color-bg)] ring-1 ring-[var(--color-border)]"
      >
      </div>
    </div>
  </Container>
</section>

<!-- USP -->
<section class="bg-[var(--color-surface)] py-20 sm:py-28">
  <Container>
    <h2
      class="max-w-md text-3xl font-[var(--font-serif)] font-medium text-[var(--color-ink)] sm:text-4xl"
    >
      {t.home.usp.title}
    </h2>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.home.usp.items.map((item) => (
          <div class="border-t border-[var(--color-border)] pt-5">
            <h3 class="font-medium text-[var(--color-ink)]">{item.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{item.text}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<!-- OFFER TEASER -->
<section class="py-20 sm:py-28">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p
          class="text-xs font-[var(--font-mono)] tracking-[0.2em] text-[var(--color-accent)] uppercase"
        >
          {t.home.offer.subtitle}
        </p>
        <h2
          class="mt-3 text-3xl font-[var(--font-serif)] font-medium text-[var(--color-ink)] sm:text-4xl"
        >
          {t.home.offer.title}
        </h2>
      </div>
      <a
        href={offerHref}
        class="text-sm font-medium text-[var(--color-brand)] hover:underline"
      >
        {t.home.offer.cta}
      </a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        [1, 2, 3].map((i) => (
          <a
            href={offerHref}
            class="group block overflow-hidden rounded-2xl ring-1 ring-[var(--color-border)]"
          >
            <div class="aspect-[4/3] bg-[var(--color-bg)] transition-transform duration-500 group-hover:scale-105" />
            <div class="p-5">
              <h3 class="font-medium text-[var(--color-ink)]">
                Inwestycja {i}
              </h3>
              <p class="mt-1 text-sm text-[var(--color-muted)]">
                Krótki opis realizacji.
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>

<!-- BLOG TEASER -->
{
  latestPosts.length > 0 && (
    <section class="border-t border-[var(--color-border)] bg-[var(--color-surface)] py-20 sm:py-28">
      <Container>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-[var(--font-mono)] tracking-[0.2em] text-[var(--color-accent)] uppercase">
              {t.home.blog.subtitle}
            </p>
            <h2 class="mt-3 text-3xl font-[var(--font-serif)] font-medium text-[var(--color-ink)] sm:text-4xl">
              {t.home.blog.title}
            </h2>
          </div>
          <a
            href={`${blogPrefix}/`}
            class="text-sm font-medium text-[var(--color-brand)] hover:underline"
          >
            {t.home.blog.cta}
          </a>
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post) => (
            <a
              href={`${blogPrefix}/${post.data.slug}/`}
              class="group flex flex-col"
            >
              <div class="mt-0 flex items-center gap-3 text-xs font-[var(--font-mono)] text-[var(--color-muted)]">
                <span>{dateFormatter.format(post.data.publishedDate)}</span>
                <span class="opacity-40">|</span>
                <span>
                  {post.readingTime} {t.blog.readingTime}
                </span>
              </div>
              <h3 class="mt-2 text-xl font-[var(--font-serif)] font-medium text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-brand)]">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm text-[var(--color-muted)]">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )
}

<!-- CTA -->
<section class="bg-[var(--color-brand-surface)] py-16 text-white">
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div>
        <h2 class="text-2xl font-[var(--font-serif)] font-medium sm:text-3xl">
          {t.home.cta.title}
        </h2>
        <p class="mt-2 text-white/80">{t.home.cta.subtitle}</p>
      </div>

      <a
        href={contactHref}
        class="shrink-0 rounded-full bg-white px-6 py-3 text-sm font-medium text-[var(--color-brand-surface)] transition-transform hover:scale-105"
      >
        {t.home.cta.button}
      </a>
    </div>
  </Container>
</section>
