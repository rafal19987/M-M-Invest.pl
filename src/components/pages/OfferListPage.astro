---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { EN_LOCALE, getTranslations, type Locale } from '@/i18n/locales/utils';
import type { OfferStatus } from '@/content.config.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const allOffers = await getCollection(
  'offers',
  ({ data }) => data.locale === locale,
);
const offers = allOffers.sort((a, b) => a.data.order - b.data.order);

const numberFormatter = new Intl.NumberFormat(
  locale === 'pl' ? 'pl-PL' : 'en-GB',
);
const offerPrefix = locale === EN_LOCALE ? '/en/offer' : '/oferta';

const statusStyles: Record<OfferStatus, string> = {
  sale: 'bg-green-100 text-green-800',
  planned: 'bg-amber-100 text-amber-800',
  sold: 'bg-gray-200 text-gray-600',
};
---

<section>
  <div>
    <p
      class="font-mono text-xs tracking-[0.2em] text-[var(--color-accent)] uppercase"
    >
      {t.offerPage.eyebrow}
    </p>
    <h1
      class="mt-3 font-serif text-4xl font-medium text-[var(--color-ink)] sm:text-5xl"
    >
      {t.offerPage.title}
    </h1>
    <p class="mt-4 max-w-xl text-[var(--color-muted)]">
      {t.offerPage.subtitle}
    </p>

    {
      offers.length === 0 && (
        <p class="mt-10 text-[var(--color-muted)]">{t.offerPage.emptyState}</p>
      )
    }

    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        offers.map((offer) => (
          <a
            href={`${offerPrefix}/${offer.data.slug}/`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-shadow hover:shadow-lg"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <Image
                src={offer.data.coverImage}
                alt={offer.data.coverImageAlt ?? ''}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[400, 800]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              />
              <span
                class={`absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-medium ${statusStyles[offer.data.status]}`}
              >
                {t.offerPage.status[offer.data.status]}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <p class="font-mono text-xs text-[var(--color-muted)]">
                {offer.data.city}
              </p>
              <h2 class="mt-1 font-serif text-xl font-medium text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-brand)]">
                {offer.data.title}
              </h2>

              <div class="mt-4 flex items-center gap-3 font-mono text-xs text-[var(--color-muted)]">
                <span>
                  {offer.data.apartmentsCount} {t.offerPage.card.apartments}
                </span>
                <span class="opacity-40">|</span>
                <span>
                  {offer.data.areaMin}–{offer.data.areaMax}{' '}
                  {t.offerPage.card.area}
                </span>
              </div>

              {offer.data.priceFrom && (
                <p class="mt-3 text-sm text-[var(--color-ink)]">
                  {t.offerPage.card.priceFrom}{' '}
                  <span class="font-medium">
                    {numberFormatter.format(offer.data.priceFrom)} zł
                  </span>
                </p>
              )}

              <span class="mt-auto pt-4 text-sm font-medium text-[var(--color-brand)]">
                {t.offerPage.card.viewDetails} →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
