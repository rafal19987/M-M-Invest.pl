---
import { getTranslations, PL_LOCALE } from '@/i18n/locales/utils';
import type { Locale } from '@/i18n/locales/utils';
import Container from '@components/Container.astro';
import LanguageSwitcher from '../LanguageSwitcher/LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = getTranslations(locale);
---

<header class="w-full bg-[#26519e]">
  <Container>
    <nav class="flex h-18 w-full items-center justify-between">
      <a class="text-white" href={locale === PL_LOCALE ? '/' : '/en/'}
        >MM Invest</a
      >

      <div class="flex items-center gap-6 text-white">
        <a
          class="hover:cursor-pointer hover:underline"
          href={locale === PL_LOCALE ? '/' : '/en/'}>{t.nav.home}</a
        >
        <a
          class="hover:cursor-pointer hover:underline"
          href={locale === PL_LOCALE ? '/o-nas/' : '/en/about-us/'}
          >{t.nav.about}</a
        >
        <a
          class="hover:cursor-pointer hover:underline"
          href={locale === PL_LOCALE ? '/oferta/' : '/en/offer/'}
          >{t.nav.offer}</a
        >
        <a
          class="hover:cursor-pointer hover:underline"
          href={locale === PL_LOCALE ? '/realizacje/' : '/en/realizations/'}
          >{t.nav.realizations}</a
        >
        <a
          class="hover:cursor-pointer hover:underline"
          href={locale === PL_LOCALE ? '/kontakt/' : '/en/contact/'}
          >{t.nav.contact}</a
        >
      </div>
      <LanguageSwitcher locale={locale} />
    </nav>
  </Container>
</header>

<script></script>
