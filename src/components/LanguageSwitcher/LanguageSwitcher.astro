---
import { EN_LOCALE, PL_LOCALE, type Locale } from '@/i18n/locales/utils';
import { getRouteKeyFromSlug, getSlugForLocale } from '@/i18n/routes';
import { LANGUAGES } from '@/global-constants.ts';

interface Props {
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { alternateUrls } = Astro.props;
const currentLocale = (Astro.currentLocale ?? PL_LOCALE) as Locale;

const currentLanguage = LANGUAGES.find((l) => l.locale === currentLocale)!;

const currentPath = Astro.url.pathname;
const segments = currentPath.split('/').filter(Boolean);

const currentSlug =
  currentLocale === EN_LOCALE
    ? segments.slice(1).join('/')
    : segments.join('/');

const routeKey = currentSlug
  ? getRouteKeyFromSlug(currentLocale, currentSlug)
  : null;

function resolveUrlForLocale(targetLocale: Locale): string {
  if (alternateUrls?.[targetLocale]) {
    return alternateUrls[targetLocale]!;
  }

  if (!currentSlug || !routeKey) {
    return targetLocale === EN_LOCALE ? '/en' : '/';
  }

  const targetSlug = getSlugForLocale(routeKey, targetLocale);
  return targetLocale === EN_LOCALE ? `/en/${targetSlug}` : `/${targetSlug}`;
}
---

<details class="group relative" data-language-switcher>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-white/20 bg-white/5 px-3 py-1.5 text-sm text-white transition-colors hover:bg-white/10"
  >
    <span aria-hidden="true">{currentLanguage.flag}</span>
    <span class="font-medium">{currentLanguage.shortLabel}</span>
    <svg
      class="h-3.5 w-3.5 text-white/70 transition-transform duration-200 group-open:rotate-180"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"></path>
    </svg>
  </summary>

  <div
    class="absolute right-0 z-50 mt-2 min-w-40 origin-top-right animate-[fadeIn_0.15s_ease-out] overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-1.5 shadow-xl ring-1 ring-black/5"
  >
    {
      LANGUAGES.map(({ locale, label, shortLabel, flag }) => {
        const isActive = locale === currentLocale;

        if (isActive) {
          return (
            <span
              class="flex cursor-default items-center gap-2.5 rounded-lg bg-[var(--color-bg)] px-3 py-2 text-sm font-medium text-[var(--color-ink)]"
              aria-current="true"
            >
              <span aria-hidden="true">{flag}</span>
              <span class="flex-1">{label}</span>
              <svg
                class="h-4 w-4 text-[var(--color-muted)]"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
          );
        }

        return (
          <a
            href={resolveUrlForLocale(locale)}
            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-[var(--color-muted)] transition-colors hover:bg-[var(--color-bg)] hover:text-[var(--color-ink)]"
            lang={locale}
          >
            <span aria-hidden="true">{flag}</span>
            <span class="flex-1">{label}</span>
          </a>
        );
      })
    }
  </div>
</details>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  function initInstance(details: HTMLDetailsElement) {
    document.addEventListener('click', (event) => {
      if (!details.open) return;

      const target = event.target as Node;
      if (!details.contains(target)) {
        details.open = false;
      }
    });
  }

  function init() {
    document.querySelectorAll('[data-language-switcher]').forEach((details) => {
      if (details instanceof HTMLDetailsElement) initInstance(details);
    });
  }

  document.addEventListener('DOMContentLoaded', init);
</script>
