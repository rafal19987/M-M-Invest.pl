---
import { getTranslations, type Locale } from '@/i18n/locales/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const options = [
  { value: 'light', label: t.theme.light },
  { value: 'dark', label: t.theme.dark },
  { value: 'system', label: t.theme.system },
] as const;
---

<details class="group relative" data-theme-switcher>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-white/20 bg-white/5 px-3 py-1.5 text-sm text-white transition-colors hover:bg-white/10"
    aria-label={t.theme.label}
  >
    <svg
      class="hidden h-4 w-4 dark:block"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
      data-icon="dark"
    >
      <path
        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
      ></path>
    </svg>
    <svg
      class="h-4 w-4 dark:hidden"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
      data-icon="light"
    >
      <path
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-9.9a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 9a1 1 0 110 2h-1a1 1 0 110-2h1zM4 9a1 1 0 110 2H3a1 1 0 110-2h1zm.464-4.95a1 1 0 011.414 0l.707.707A1 1 0 105.171 6.17l-.707-.707a1 1 0 010-1.414zM10 15a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zm-4.95-.464a1 1 0 011.414 1.414l-.707.707a1 1 0 01-1.414-1.414l.707-.707z"
      ></path>
    </svg>
  </summary>

  <div
    class="absolute right-0 z-50 mt-2 min-w-32 origin-top-right animate-[fadeIn_0.15s_ease-out] overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-1.5 shadow-xl ring-1 ring-black/5"
  >
    {
      options.map(({ value, label }) => (
        <button
          type="button"
          data-theme-value={value}
          class="flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm text-[var(--color-muted)] transition-colors hover:bg-[var(--color-bg)] hover:text-[var(--color-ink)]"
        >
          <span class="flex-1">{label}</span>
          <svg
            class="hidden h-4 w-4 text-[var(--color-brand)] [.is-active_&]:block"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      ))
    }
  </div>
</details>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  function applyTheme(theme: string) {
    const prefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)',
    ).matches;
    const isDark = theme === 'dark' || (theme === 'system' && prefersDark);
    document.documentElement.classList.toggle('dark', isDark);
  }

  function updateActiveOption(theme: string) {
    document.querySelectorAll('[data-theme-value]').forEach((btn) => {
      btn.classList.toggle(
        'is-active',
        btn.getAttribute('data-theme-value') === theme,
      );
    });
  }

  function init() {
    const stored = localStorage.getItem('theme') || 'system';
    updateActiveOption(stored);

    document.querySelectorAll('[data-theme-value]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.getAttribute('data-theme-value')!;
        localStorage.setItem('theme', value);
        applyTheme(value);
        updateActiveOption(value);

        const details = btn.closest('[data-theme-switcher]');
        if (details instanceof HTMLDetailsElement) details.open = false;
      });
    });

    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        const current = localStorage.getItem('theme') || 'system';
        if (current === 'system') applyTheme('system');
      });
  }

  document.addEventListener('DOMContentLoaded', init);
</script>
