---
import { getTranslations, type Locale } from '@/i18n/locales/utils';
import Container from '@components/Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = getTranslations(locale);
---

<footer class="h-fit min-h-96 w-full bg-[#26519e] p-24 text-white">
  <Container>
    <div class="flex h-full w-full gap-8">
      <div class="flex flex-col gap-4">
        <h3 class="font-semibold">{t.footer.openHours.title}</h3>
        <ul class="flex flex-col gap-1">
          <li>{t.footer.openHours.monFri}</li>
          <li>{t.footer.openHours.saturday}</li>
          <li>{t.footer.openHours.sunday}</li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-xl">{t.footer.company.title}</h3>
        <ul class="flex flex-col gap-1">
          <li>Realizacje Danych</li>
          <li>Realizacje Elewacje</li>
          <li>Transport</li>
          <li>Aktualności</li>
          <li>Blog</li>
          <li>Działania społeczne</li>
          <li>Polityka prywatności</li>
          <li>Oddziały</li>
          <li>Kontakt</li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-xl">Materiały budowlane</h3>
        <ul class="flex flex-col gap-1">
          <li>Dachy</li>
          <li>Ocieplenia i elewacje</li>
          <li>Kostka brukowa i ogrodzenia</li>
          <li>Materiały wykończeniowe</li>
          <li>Materiały konstrukcyjne</li>
          <li>Łazienki</li>
          <li>Drzwi i podłogi</li>
          <li>Balkony i tarasy</li>
          <li>Garaż</li>
          <li>Ogród</li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-xl">Lokalizacja i kontakt</h3>
        <ul class="flex flex-col gap-1">
          <li class="text-md font-bold">JETRO Karol Walo</li>
          <li>Świdry 1F</li>
          <li>21-400 Łuków</li>
          <li>NIP: PL 825 106 73 94</li>
        </ul>
        <ul>
          <li class="font-bold">
            tel.: <span class="font-normal">25 798 68 48</span>
          </li>
          <li class="font-bold">
            email: <span class="font-normal">jetro@jetro.com.pl</span>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</footer>
